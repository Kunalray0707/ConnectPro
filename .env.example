# Copy to .env and fill in values

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripe (frontend publishable key)
VITE_STRIPE_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXX

# Razorpay (optional)
VITE_RAZORPAY_KEY=

# Stripe backend (dev: leave empty to use Vite proxy at /api)
VITE_API_URL=

# Server (.env in /server) — STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, CORS_ORIGIN

